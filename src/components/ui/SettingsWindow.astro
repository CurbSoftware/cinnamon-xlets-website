---
// A re-created Cinnamon settings window fragment in pure HTML/CSS.
// Callers pass REAL labels from the xlet's settings-schema.json (spec:
// truthful labels only; this is the tactility moment). The controls are
// presentational squares and rows, not interactive widgets.
//
// Props:
//   title: window title bar text
//   rows:  ordered list. Two row kinds:
//          - a section header row: { section } on its own
//          - a control row: label + type (switch | select | entry | button),
//            optionally opening a new section (section first), with value as
//            the shown value (select/entry/button text), hint as a dependency
//            label under the row, on for switches
export interface SettingsSectionRow {
  section: string;
}

export interface SettingsControlRow {
  section?: string;
  label: string;
  type: 'switch' | 'select' | 'entry' | 'button';
  value?: string;
  hint?: string;
  on?: boolean;
}

export type SettingsRow = SettingsSectionRow | SettingsControlRow;

interface Props {
  title: string;
  rows: SettingsRow[];
  class?: string;
}

const { title, rows, class: className } = Astro.props;
---

<div class:list={['settings-window', className]} role="group" aria-label={`${title} settings window`}>
  <div class="settings-window__chrome">
    <span class="settings-window__title">{title}</span>
    <span class="settings-window__close" aria-hidden="true"></span>
  </div>
  <div class="settings-window__body">
    {rows.map((row) => {
      const control = 'label' in row ? row : null;
      return control ? (
        <>
          {control.section && <h3 class="settings-window__section">{control.section}</h3>}
          <div class="settings-window__row">
            <span class="settings-window__label">
              {control.label}
              {control.hint && <span class="settings-window__hint">{control.hint}</span>}
            </span>
            {control.type === 'switch' && (
              <span class:list={['sw', { 'sw--on': control.on }]} aria-hidden="true">
                <span class="sw__thumb"></span>
              </span>
            )}
            {control.type === 'select' && (
              <span class="settings-window__select" aria-hidden="true">
                {control.value}
                <span class="settings-window__caret"></span>
              </span>
            )}
            {control.type === 'entry' && (
              <span class="settings-window__entry" aria-hidden="true">{control.value}</span>
            )}
            {control.type === 'button' && (
              <span class="settings-window__button" aria-hidden="true">{control.value}</span>
            )}
          </div>
        </>
      ) : (
        <h3 class="settings-window__section">{row.section}</h3>
      );
    })}
  </div>
</div>

<style>
  .settings-window {
    max-width: 34rem;
    border: var(--hairline-width) solid var(--hairline);
    background: oklch(var(--card));
    box-shadow: var(--shadow-lg);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: oklch(var(--card-foreground));
  }

  .settings-window__chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-bottom: var(--hairline-width) solid var(--rule);
    font-weight: 600;
  }

  .settings-window__close {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border: var(--hairline-width) solid oklch(var(--muted-foreground));
  }

  .settings-window__body {
    padding: var(--space-2) var(--space-3) var(--space-4);
  }

  .settings-window__section {
    margin: var(--space-4) 0 var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: oklch(var(--muted-foreground));
  }

  .settings-window__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-2);
  }

  .settings-window__label {
    display: grid;
  }

  .settings-window__hint {
    font-size: var(--text-xs);
    color: oklch(var(--muted-foreground));
  }

  /* switch */
  .sw {
    inline-size: 2.25rem;
    block-size: 1rem;
    border: var(--hairline-width) solid var(--hairline-strong);
    background: oklch(var(--muted));
    position: relative;
    flex: none;
  }

  .sw__thumb {
    position: absolute;
    top: 1px;
    left: 1px;
    inline-size: calc(50% - 2px);
    block-size: calc(100% - 2px);
    background: oklch(var(--muted-foreground));
  }

  .sw--on {
    background: oklch(var(--primary) / 0.25);
  }

  .sw--on .sw__thumb {
    left: 50%;
    background: oklch(var(--primary));
  }

  /* select, entry, button: hard-edged Cinnamon controls */
  .settings-window__select,
  .settings-window__entry,
  .settings-window__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-inline-size: 9rem;
    padding: var(--space-1) var(--space-2);
    border: var(--hairline-width) solid var(--hairline-strong);
    background: oklch(var(--background));
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .settings-window__button {
    justify-content: center;
    min-inline-size: auto;
  }

  .settings-window__caret {
    margin-left: auto;
    inline-size: 0;
    block-size: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid oklch(var(--muted-foreground));
  }
</style>
