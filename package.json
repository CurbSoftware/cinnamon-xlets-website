{
  "name": "cinnamon-xlets-website",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sync:assets": "node scripts/sync-screenshots.mjs",
    "shoot": "pnpm build && (pnpm preview --port 4399 &) && sleep 2 && node scripts/shoot.mjs",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "astro": "^7.2.10"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "lighthouse": "^13.4.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
